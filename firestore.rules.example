rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      // The main website writes customer inquiries to the "leads" collection.
      // serverTimestamp() is evaluated as request.time by Firestore Rules.
      allow create: if
        request.resource.data.keys().hasAll([
          'leadId',
          'fullName',
          'email',
          'phone',
          'companyName',
          'projectType',
          'budget',
          'deliveryTime',
          'websiteURL',
          'projectDescription',
          'status',
          'submittedAt',
          'date',
          'time'
        ]) &&
        request.resource.data.keys().hasOnly([
          'leadId',
          'fullName',
          'email',
          'phone',
          'companyName',
          'projectType',
          'budget',
          'deliveryTime',
          'websiteURL',
          'projectDescription',
          'status',
          'submittedAt',
          'date',
          'time'
        ]) &&
        request.resource.data.leadId is string &&
        request.resource.data.leadId.size() > 0 &&
        request.resource.data.leadId.size() <= 40 &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.fullName.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 40 &&
        request.resource.data.companyName is string &&
        request.resource.data.companyName.size() <= 160 &&
        request.resource.data.projectType is string &&
        request.resource.data.projectType.size() <= 100 &&
        request.resource.data.budget is string &&
        request.resource.data.budget.size() <= 40 &&
        request.resource.data.deliveryTime is string &&
        request.resource.data.deliveryTime.size() <= 100 &&
        request.resource.data.websiteURL is string &&
        request.resource.data.websiteURL.size() <= 500 &&
        request.resource.data.projectDescription is string &&
        request.resource.data.projectDescription.size() > 0 &&
        request.resource.data.projectDescription.size() <= 5000 &&
        request.resource.data.status == 'New' &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.date is string &&
        request.resource.data.date.size() <= 20 &&
        request.resource.data.time is string &&
        request.resource.data.time.size() <= 20;

      // Customer inquiries are private. Public visitors cannot read or alter them.
      allow read, update, delete: if false;
    }
  }
}
